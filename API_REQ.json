      "method": "POST",
      "className": "MyApp",
      "request": "ACRA JSON crash report",
      "usedBy": [
        "MyApp"
      ]
    },
    {
      "name": "Internet connectivity probe",
      "endpoint": "https://clients3.google.com/generate_204",
      "method": "GET",
      "className": "InternetCheckerSimple",
      "usedBy": [
        "InternetCheckerSimple"
      ]
    }
  ]
}
