<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/update_layout_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:padding="16dp"

    >

    <!-- Rocket Image -->
    <ImageView
        android:id="@+id/rocket_image"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/update_rocket"
        android:layout_centerHorizontal="true"
        android:translationX="70dp"
        android:translationY="18dp"
        android:layout_marginTop="-60dp"
        android:elevation="1dp" />

    <!-- CardView Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/update_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/rocket_image"
        android:layout_marginTop="-40dp"
        app:cardCornerRadius="16dp"
        android:background="@android:color/transparent"
        app:cardUseCompatPadding="true"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="true"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:id="@+id/update_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⊹₊ ⋆ NEW UPDATE AVAILABLE ⋆ ₊⊹"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:textSize="20sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/li_sohid_unicode"/>

            <!-- Version & label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/alertUpdatebangla"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Changes in Update"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="@font/poppins_regular"/>

                <TextView
                    android:id="@+id/newVer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="V 0.5.6"
                    android:textColor="@color/green"
                    android:textAllCaps="true"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="@font/li_sohid_unicode"/>
            </LinearLayout>

            <!-- Plain Description -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="8dp"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/alertUpdateDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Here goes your update description. You can add multiple lines and it will wrap automatically."
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="@font/poppins_regular"/>

            </ScrollView>

            <!-- Bottom Button -->
            <FrameLayout
                android:id="@+id/update_rl_button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/rounded_green_background">

                <TextView
                    android:id="@+id/update_btn_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UPDATE NOW"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:textSize="14sp"
                    android:fontFamily="@font/li_sohid_unicode"/>

                <ProgressBar
                    android:id="@+id/progressBarUpdate"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_bar_custom"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/downloadProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/red"
                    android:textSize="16sp"
                    android:visibility="gone"
                    android:fontFamily="@font/li_sohid_unicode"/>
            </FrameLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>