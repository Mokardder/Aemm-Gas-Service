<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/alertDialog_userdetails"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:id="@+id/dialog_box"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:cardCornerRadius="15dp"
        app:cardElevation="8dp">


        <!--    LoaderView -->
        <LinearLayout
            android:id="@+id/loaderLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="#80000000"
            android:elevation="20dp"
            android:visibility="gone"
            android:focusable="true"
            android:clickable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="no">

            <!-- ProgressBar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="#FFFFFF"
                android:indeterminate="true" />

            <!-- Loading Text -->
            <TextView
                android:id="@+id/loadingText_alert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fetching Customers..."
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">



            <ImageView
                android:id="@+id/success_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/user_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="16dp" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consumer ID"
                android:fontFamily="@font/poppins_regular"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                app:layout_constraintStart_toEndOf="@+id/success_icon"
                app:layout_constraintTop_toTopOf="@+id/success_icon"
                android:layout_marginStart="8dp" />

            <EditText
                android:id="@+id/et_consID"
                android:inputType="number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:hint="Consumer ID"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/title"
                app:layout_constraintTop_toBottomOf="@+id/title"
                android:background="@drawable/round_grey"
                android:paddingLeft="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

            <TextView
                android:visibility="gone"
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:maxWidth="180dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Momtaz Bibi (7010203040)"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/et_consID"
                app:layout_constraintTop_toBottomOf="@id/et_consID" />

            <Button
                android:id="@+id/btn_fetch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fetch Data"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/userName"
                android:backgroundTint="@color/primary_color"
                android:background="@drawable/round_primary"
                android:textColor="@android:color/white" />
            <Button
                android:visibility="gone"
                android:id="@+id/btn_saveData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save Data"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/userName"
                android:backgroundTint="@color/primary_color"
                android:background="@drawable/round_primary"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/btn_skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_blue_background"
                android:backgroundTint="@color/primary_color"
                android:text="SKIP FCM"
                android:textColor="@color/blue"
                android:layout_marginLeft="10dp"
                android:paddingHorizontal="7dp"
                android:visibility="visible"

                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                app:layout_constraintStart_toEndOf="@+id/btn_fetch"
                app:layout_constraintTop_toBottomOf="@+id/btn_fetch" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
