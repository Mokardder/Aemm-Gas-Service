<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/alertDialog_startup"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_centerInParent="true"
        android:layout_height="wrap_content"
        app:cardCornerRadius="18dp"
        android:background="#f8f9fa"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:padding="8dp">

            <RelativeLayout
                android:id="@+id/rl_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:padding="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_yellow_background"
                    android:fontFamily="@font/poppins_regular"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="WARNING"
                    android:textColor="@color/yellow"

                    android:textStyle="bold" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/user_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_header"
                android:layout_centerVertical="true"
                android:padding="5dp">


                <TextView
                    android:id="@+id/tv_relative_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Realme This Device is Odd Turn on those settings"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/startPermanentService"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:layout_below="@+id/tv_relative_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mafuj_bangla"
                    android:background="@drawable/rounded_yellow_background"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:text="Start Permanent Service"
                    android:textColor="@color/yellow"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/start2Px"
                    android:layout_below="@+id/startPermanentService"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mafuj_bangla"
                    android:background="@drawable/rounded_yellow_background"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:layout_marginTop="5dp"
                    android:text="Start 2 PX"
                    android:textColor="@color/yellow"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/smsRole"
                    android:layout_below="@+id/start2Px"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mafuj_bangla"
                    android:background="@drawable/rounded_yellow_background"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:layout_marginTop="5dp"
                    android:text="Start SMS Role"
                    android:textColor="@color/yellow"
                    android:textSize="15sp" />
                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_below="@+id/smsRole"
                    android:id="@+id/tv_relative_txt_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/black"
                    android:text="To Reactivate the account press the call button"

                    android:textSize="12sp" />

            </RelativeLayout>
            <RelativeLayout
                android:layout_below="@+id/user_info"
                android:layout_width="wrap_content"
                android:layout_centerHorizontal="true"
                android:padding="5dp"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/closeDialog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                   android:drawablePadding="5dp"
                    android:background="@drawable/rounded_yellow_background"
                    android:textColor="@color/yellow"
                    android:text="Close"
                    />

            </RelativeLayout>

        </RelativeLayout>

        <Button
            android:id="@+id/gef"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:text="HIDE"
            android:visibility="invisible"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:background="@drawable/rounded_red_background" />
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
