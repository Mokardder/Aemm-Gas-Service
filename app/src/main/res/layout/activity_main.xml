<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Ui.MainActivity"
    tools:ignore="HardcodedText">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="15dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <!-- Header Text -->
                <TextView
                    android:id="@+id/tv_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="20sp"
                    android:maxHeight="50sp"
                    android:layout_centerHorizontal="true"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Aemm Gas Service"
                    android:textColor="@color/black"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText"

                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="28sp"
                    android:autoSizeStepGranularity="1sp"

                    />

                <!-- App Version -->
                <TextView
                    android:id="@+id/tv_appVersion"
                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"
                    android:layout_alignEnd="@id/tv_header"
                    android:layout_alignBottom="@+id/tv_header"
                    android:layout_marginTop="50dp"
                    android:background="@drawable/rounded_blue_background"
                    android:fontFamily="@font/poppins_regular"
                    android:paddingHorizontal="3dp"
                    android:text="OUTDATED - 1.9-100"
                    android:textColor="@color/red"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="28sp"
                    android:autoSizeStepGranularity="1sp"

                    />

            </RelativeLayout>

            <!-- User Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/userName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxHeight="18sp"
                            android:fontFamily="@font/poppins_regular"
                            android:text=""
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="10sp"
                            android:autoSizeMaxTextSize="28sp"
                            android:autoSizeStepGranularity="1sp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <ImageView

                            android:id="@+id/annualTick"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:maxHeight="25dp"
                            android:maxWidth="25dp"
                            android:minHeight="20dp"
                            android:minWidth="20dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/verify_icon_blue"
                            android:visibility="gone" />
                    </LinearLayout>




                    <com.google.android.flexbox.FlexboxLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:flexWrap="wrap"
                        app:justifyContent="center"
                        app:alignItems="center">

                        <TextView
                            android:id="@+id/refreshProfile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:background="@drawable/rounded_background"
                            android:clickable="true"
                            android:drawablePadding="12dp"
                            android:focusable="true"
                            android:fontFamily="@font/poppins_regular"
                            android:foreground="?android:attr/selectableItemBackgroundBorderless"
                            android:paddingHorizontal="8dp"
                            android:text="Refresh Profile"
                            android:textColor="@color/black"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="10sp"
                            android:autoSizeMaxTextSize="28sp"
                            android:autoSizeStepGranularity="1sp" />

                        <FrameLayout
                            android:id="@+id/fl_tvAppUpdate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp">

                            <TextView
                                android:id="@+id/Check_Update"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/rounded_background"
                                android:clickable="true"
                                android:drawablePadding="12dp"
                                android:focusable="true"
                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="10sp"
                                android:autoSizeMaxTextSize="28sp"
                                android:autoSizeStepGranularity="1sp"
                                android:fontFamily="@font/poppins_regular"
                                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                                android:paddingHorizontal="8dp"

                                android:text="Check Update"
                                android:textColor="@color/black" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/aboutApp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:background="@drawable/rounded_background"
                            android:clickable="true"
                            android:drawablePadding="12dp"
                            android:focusable="true"
                            android:fontFamily="@font/poppins_regular"
                            android:foreground="?android:attr/selectableItemBackgroundBorderless"
                            android:paddingHorizontal="8dp"
                            android:text="About"
                            android:textColor="@color/black"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="10sp"
                            android:autoSizeMaxTextSize="28sp"
                            android:autoSizeStepGranularity="1sp" />

                        <TextView
                            android:id="@+id/interestialAds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:background="@drawable/rounded_background"
                            android:clickable="true"
                            android:drawablePadding="12dp"
                            android:focusable="true"
                            android:visibility="gone"
                            android:fontFamily="@font/poppins_regular"
                            android:foreground="?android:attr/selectableItemBackgroundBorderless"
                            android:paddingHorizontal="8dp"
                            android:text="Earn ₹319.57 💸"
                            android:textColor="@color/black" />

                        <TextView
                            android:visibility="visible"
                            android:id="@+id/permissionPage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:background="@drawable/rounded_background"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/poppins_regular"
                            android:foreground="?android:attr/selectableItemBackgroundBorderless"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="1dp"
                            android:text="Permissions"
                            android:textColor="@color/black" />

                        <TextView
                            android:visibility="visible"
                            android:id="@+id/changeUser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:background="@drawable/rounded_background"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/poppins_regular"
                            android:foreground="?android:attr/selectableItemBackgroundBorderless"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="1dp"
                            android:text="Change User"
                            android:textColor="@color/black" />

                    </com.google.android.flexbox.FlexboxLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


<!--            <com.google.android.gms.ads.AdView-->
<!--                android:visibility="gone"-->
<!--                android:id="@+id/adView"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                ads:adSize="BANNER"-->
<!--                ads:adUnitId="@string/banner_ad_unit_id"-->
<!--                xmlns:ads="http://schemas.android.com/apk/res-auto"/>-->


            <!-- Remaining Book & Last Book Date Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="10dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="15dp">

                    <RelativeLayout
                        android:id="@+id/rl_remain_annual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:textAlignment="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxHeight="40sp"
                            android:minHeight="30sp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Remaining Book"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="10sp"
                            android:autoSizeMaxTextSize="28sp"
                            android:autoSizeStepGranularity="1sp"

                            />

                        <TextView
                            android:id="@+id/remainBook"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="30dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="0"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="10sp"
                            android:autoSizeMaxTextSize="28sp"
                            android:autoSizeStepGranularity="1sp"

                            />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_toRightOf="@+id/rl_remain_annual">

                        <TextView
                            android:id="@+id/tv_lastBook"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxHeight="25sp"
                            android:minHeight="20sp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Last Book Date"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="10sp"
                            android:autoSizeMaxTextSize="28sp"
                            android:autoSizeStepGranularity="1sp"

                            />

                        <TextView
                            android:id="@+id/lastBook"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="30dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text=""
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="10sp"
                            android:autoSizeMaxTextSize="28sp"
                            android:autoSizeStepGranularity="1sp"

                            />
                    </RelativeLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Call Button Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="10dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="15dp">

                    <TextView
                        android:id="@+id/call_Akram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:background="@drawable/rounded_blue_background"
                        android:clickable="true"
                        android:drawableLeft="@drawable/call_outgoing"
                        android:drawablePadding="5dp"
                        android:fontFamily="@font/poppins_regular"
                        android:padding="5dp"
                        android:paddingHorizontal="7dp"
                        android:text="Akram"
                        android:textColor="@color/blue"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeMaxTextSize="28sp"
                        android:autoSizeStepGranularity="1sp"

                        />

                    <TextView
                        android:id="@+id/call_Emdadul"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:layout_toRightOf="@+id/call_Akram"
                        android:background="@drawable/rounded_blue_background"
                        android:drawableLeft="@drawable/call_outgoing"
                        android:drawablePadding="5dp"
                        android:padding="5dp"
                        android:fontFamily="@font/poppins_regular"
                        android:paddingHorizontal="7dp"
                        android:text="Emdadul"
                        android:textColor="@color/blue"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeMaxTextSize="28sp"
                        android:autoSizeStepGranularity="1sp"

                        />

                    <TextView
                        android:id="@+id/call_Mokardder"
                        android:layout_width="wrap_content"
                        android:maxWidth="110sp"
                        android:layout_height="wrap_content"
                        android:maxHeight="30sp"
                        android:layout_toRightOf="@+id/call_Emdadul"
                        android:fontFamily="@font/poppins_regular"
                        android:background="@drawable/rounded_blue_background"
                        android:drawableLeft="@drawable/call_outgoing"
                        android:drawablePadding="5dp"
                        android:padding="5dp"
                        android:paddingHorizontal="9dp"
                        android:text="Mokardder"
                        android:textColor="@color/blue"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeStepGranularity="1sp"

                        />


                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- User Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="User Information"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Mobile No -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Mobile No"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/mobNo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxHeight="25sp"
                            android:maxWidth="190sp"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_regular"
                            android:text="9932896502 / 9123386785"
                            android:textColor="#6E6C6C"
                            android:textSize="15sp"
                            android:ellipsize="end"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Additional user details -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Consumer ID"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/consID"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/poppins_regular"
                            android:text=""
                            android:textColor="#6E6C6C"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </RelativeLayout>


                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
                android:id="@+id/cardSubsidyHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="false"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:visibility="visible">

                <!-- Use FrameLayout so we can stack the badge and dot -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- your existing content -->
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:padding="5dp">

                            <ImageView
                                android:id="@+id/img_lpg_subsidy"
                                android:layout_width="80dp"
                                android:layout_height="100dp"
                                android:src="@drawable/lpg_subsidy_img" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="20dp"
                                android:layout_toRightOf="@+id/img_lpg_subsidy"
                                android:fontFamily="@font/li_sohid_unicode"
                                android:text="গ্যাসের সাবসিডি চেক করুন"
                                android:textAlignment="center"
                                android:textColor="@color/blue"
                                android:textSize="18dp" />
                        </RelativeLayout>

                    </RelativeLayout>

                    <!-- RECEIVED badge in top-right -->
                    <TextView
                        android:id="@+id/badgeReceived"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_badge_req"
                        android:elevation="4dp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="REQUEST"
                        android:textColor="@android:color/white"
                        android:textFontWeight="900"
                        android:textSize="12sp"
                        android:textStyle="bold" />


                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
<!--            <com.google.android.gms.ads.AdView-->
<!--                android:visibility="gone"-->
<!--                android:id="@+id/adView2"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                ads:adSize="BANNER"-->
<!--                ads:adUnitId="@string/banner_ad_unit_id"-->
<!--                xmlns:ads="http://schemas.android.com/apk/res-auto"/>-->


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="180dp">

                <TextView
                    android:id="@+id/Book_Btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:background="@drawable/rounded_blue_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_regular"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:paddingHorizontal="40dp"
                    android:paddingVertical="20dp"
                    android:text="BOOK"
                    android:textColor="#0d6efd" />
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Loader Overlay -->
    <LinearLayout
        android:id="@+id/loaderLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:indeterminateTint="#FFFFFF" />

        <TextView
            android:id="@+id/loadingText_UI"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Fetching Customers..."
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
