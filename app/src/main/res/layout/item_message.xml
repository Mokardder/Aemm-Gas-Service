<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <!-- Incoming bubble (left) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/leftBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginHorizontal="3dp"
        android:visibility="gone"

        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeWidth="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvBodyLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:text="Left side message sample text"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="#FFFFFF"
            android:lineSpacingExtra="2dp"
            android:autoLink="all"
            android:includeFontPadding="false"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"/>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvTimeLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12:45 PM"
        android:visibility="gone"
        android:layout_marginStart="10sp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="#B3B3B3"
        app:layout_constraintStart_toStartOf="@id/leftBubble"
        app:layout_constraintTop_toBottomOf="@id/leftBubble"
        android:layout_marginTop="2dp"/>

    <!-- Outgoing bubble (right) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rightBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FF9800"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvBodyRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:text="Right side message sample text"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="#FFFFFF"
            android:lineSpacingExtra="2dp"
            android:autoLink="all"
            android:includeFontPadding="false"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"/>
    </com.google.android.material.card.MaterialCardView>



    <TextView
        android:id="@+id/tvTimeRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12:46 PM"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="#B3B3B3"
        android:visibility="gone"
        android:layout_marginEnd="10sp"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@id/rightBubble"
        app:layout_constraintTop_toBottomOf="@id/rightBubble"/>




</androidx.constraintlayout.widget.ConstraintLayout>
