<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/alertDialog_startup"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_centerInParent="true"
        android:layout_height="wrap_content"
        app:cardCornerRadius="18dp"
        android:background="#f8f9fa"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <RelativeLayout
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:padding="8dp">

            <RelativeLayout
                android:id="@+id/rl_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:padding="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_yellow_background"
                    android:fontFamily="@font/poppins_regular"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Subsidy Request"
                    android:textColor="@color/yellow"

                    android:textStyle="bold" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/user_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_header"
                android:layout_centerVertical="true"
                android:padding="5dp">


                <TextView
                    android:id="@+id/tv_relative_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mafuj_bangla"
                    android:text="গ্যাসের সাবসিডি চেক করার জন্য নিচে 'SUBMIT' এ ক্লিক করুন\n\nআপনাকে কমপক্ষে ২ দিন অপেক্ষা করতে হবে\nComplete হয়েগেলে Notification আসবে"
                    android:textColor="@color/blue"
                    android:textFontWeight="600"
                    android:textSize="16sp" />




            </RelativeLayout>
            <RelativeLayout
                android:layout_below="@+id/user_info"
                android:layout_width="wrap_content"
                android:layout_centerHorizontal="true"
                android:padding="5dp"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/fetchBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"

                    android:drawablePadding="5dp"
                    android:background="@drawable/rounded_blue_background"
                    android:textColor="#0d6efd"
                    android:text="SUBMIT"
                    />

            </RelativeLayout>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
