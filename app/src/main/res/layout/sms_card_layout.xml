<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_root"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="22dp"
        app:cardElevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="#E5E7EB"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_border_selectable_item"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="SMS • 12:30"
                android:textColor="#334155"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/rounded_border_selectable_item"
                android:padding="2dp"
                android:src="@drawable/close_small"
                app:layout_constraintBottom_toBottomOf="@id/tv_header"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_header" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_bank"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/gas_cylinder_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_header"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_Circle"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/tv_bank_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="DAC CODE (GAS)"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/verified_img"
                app:layout_constraintStart_toEndOf="@id/img_bank"
                app:layout_constraintTop_toTopOf="@id/img_bank" />

            <ImageView
                android:id="@+id/verified_img"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/verify_icon_blue"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/tv_bank_name"
                app:layout_constraintStart_toEndOf="@id/tv_bank_name"
                app:layout_constraintTop_toTopOf="@id/tv_bank_name" />

            <TextView
                android:id="@+id/tv_otp_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/li_sohid_unicode"
                android:maxLines="2"
                android:text="গ্যাস ওয়ালা কে ফোন করতে নিচে click করুন"
                android:textColor="#64748B"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/tv_bank_name"
                app:layout_constraintTop_toBottomOf="@id/tv_bank_name" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#EEF6FF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/img_bank"
                app:strokeColor="#D0E6FF"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tv_otp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="14dp"
                    android:text="9902"
                    android:textColor="@color/blue"
                    android:textSize="34sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/btn_call"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/rounded_call_button"
                android:drawablePadding="8dp"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="CALL EMDADUL"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textColor="@color/blue"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_content" />

            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="82dp"
                android:layout_height="18dp"
                android:layout_marginTop="10dp"
                android:alpha="0.65"
                android:src="@drawable/aemm_text_logo"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_call"
                app:tint="#94A3B8" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
